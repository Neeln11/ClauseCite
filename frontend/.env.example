# Copy to .env for local dev — the default already points at the local
# backend (127.0.0.1:8000), so this file only matters when the API lives
# somewhere else.
#
#   cp .env.example .env

# Vercel / any non-local deploy: point this at the deployed backend, e.g.
# https://clausecite-api.onrender.com — no trailing slash needed, the client
# strips one if present. Set this in the Vercel project's Environment
# Variables (Settings > Environment Variables), not by committing a .env file.
VITE_API_URL=http://127.0.0.1:8000
