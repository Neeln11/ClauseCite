# Copy to .env and you are done — the defaults run the whole application with
# nothing installed: no Docker, no database server, no API key.
#
#   cp .env.example .env
#
# Every variable here is parsed through backend/app/config.py, so a malformed
# value fails at startup with a clear message rather than at 3am inside a
# request handler.

ENVIRONMENT=local
LOG_LEVEL=INFO
# Both spellings of the dev origin: Vite prints localhost, but people bookmark
# 127.0.0.1, and a mismatch here shows up as an opaque CORS failure.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ---------------------------------------------------------------
# SQLite by default: a single file, created on first run, no server to install.
# Retrieval then scores vectors in Python, which is fine for a laptop-sized
# corpus and is the reason production uses PostgreSQL instead.
DATABASE_URL=sqlite+aiosqlite:///./.data/docqa.db
#
# PostgreSQL + pgvector (indexed vector search, full-text ranking). Requires the
# `vector` extension; `docker compose up -d db` provides one on port 5433:
# DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5433/docqa

# ---- File storage -----------------------------------------------------------
# No Azure account involved: the "local:" prefix tells the storage code (see
# backend/app/services/storage.py) to keep uploaded PDFs on the local
# filesystem instead. The variable name is only reused from Azure's connection-
# string shape as a generic interface; nothing here talks to Azure. If this
# project ever moves to real Azure Blob storage, the connection string would
# instead look like:
#   AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_CONNECTION_STRING=local:./.data/blobs
AZURE_STORAGE_CONTAINER=documents

# ---- Answering mode ---------------------------------------------------------
# There is nothing to configure here to get answers.
#
#   No API key   -> answers are selected and quoted from your uploaded documents.
#   With a key   -> a model generates the answer from those same documents and
#                   may add general knowledge, which it must label as such.
#
# The key is pasted into the UI, not set here: provider, endpoint, and model are
# detected from the key's prefix (OpenAI, Anthropic, Groq, OpenRouter, Mistral,
# Together, or any OpenAI-compatible server).
#
# The pasted key is cached in PROVIDER_KEY_FILE so it survives a restart. That
# file holds it in plain text — same trust level as this .env, and gitignored.
# Set this to false on a shared machine to keep the key in memory only.
PERSIST_PROVIDER_KEY=true
PROVIDER_KEY_FILE=./.data/provider.json

# ---- Retrieval and generation ----------------------------------------------
# RETRIEVAL_TOP_K is fetched per search strategy and fused down to
# RETRIEVAL_FINAL_K sources before they reach the model.
RETRIEVAL_TOP_K=12
RETRIEVAL_FINAL_K=6
RETRIEVAL_HYBRID=true
MAX_CONTEXT_TOKENS=6000

# Chunking. Clause-aware splitting is what these numbers feed; see
# backend/app/services/chunk.py for why the boundaries matter more than the sizes.
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=100

MAX_UPLOAD_MB=25
